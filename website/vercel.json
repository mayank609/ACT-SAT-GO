{
  "version": 2,
  "buildCommand": "cd nextgen-react && npm install && npm run build && cd .. && mkdir -p public && cp -r nextgen-react/dist/* public/",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
